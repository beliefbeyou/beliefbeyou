---
import { centers, thresholds } from '../data/questions.js';

const LINE_URL = 'https://lin.ee/r0ZWBxZ';
const SITE_NAME = '一朵雲身心美學療癒';

// 供前端計分用的精簡資料（不含題目本身，題目直接渲染在頁面上）
const clientData = {
  thresholds,
  centers: centers.map((c) => ({
    order: c.order,
    name: c.name,
    sanskrit: c.sanskrit,
    theme: c.theme,
    high: c.high,
    mid: c.mid,
    low: c.low,
    advice: c.advice,
    max: c.questions.reduce((sum, q) => sum + Math.max(...q.options.map((o) => o.s)), 0),
  })),
};

const totalQuestions = centers.reduce((n, c) => n + c.questions.length, 0);
let qNum = 0;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>中脈能量測評｜一朵雲身心美學療癒</title>
    <meta
      name="description"
      content="49 題專業版中脈能量測評——透過七大能量中心的檢視，找到你的心相卡點，開啟內外整合的順流之旅。"
    />
    <meta property="og:title" content="中脈能量測評｜一朵雲身心美學療癒" />
    <meta
      property="og:description"
      content="49 題專業版中脈能量測評——找到你的心相卡點，開啟順流之旅。"
    />
    <link
      rel="icon"
      href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><path fill="%23C9A86C" d="M20 46a13 13 0 1 1 2.8-25.7A17 17 0 0 1 55 27.6 11 11 0 0 1 51.5 49H20z"/></svg>'
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>

    <header class="site-header">
      <div class="brand">
        <img src="/images/logo.png" alt="一朵雲身心美學療癒" class="brand-logo" />
        <p class="brand-en">Be Lief Essence &amp; Aesthetic Empowerment Academy</p>
      </div>
    </header>

    <main>
      <!-- ══════════ 首頁 ══════════ -->
      <section id="view-intro" class="view">
        <p class="kicker">HOLISTIC ENERGY ASSESSMENT</p>
        <h1 class="hero-title">中脈能量測評</h1>
        <p class="hero-sub">49 題專業版・找到你的心相卡點</p>
        <div class="gold-rule" aria-hidden="true"></div>
        <p class="hero-lead">
          中脈能量中心，是你內在狀態的一面鏡子。<br />
          透過這份測評，看見能量正在順流之處<br />
          也溫柔展示出，你目前正在經歷的卡點
        </p>

        <div class="card notice-card">
          <h2 class="card-title">測評須知</h2>
          <ol class="notice-list">
            <li>透過中脈能量測評，找到<strong>自己的心相卡點</strong></li>
            <li>本測評共 <strong>49 道題</strong>，更準確反映你的情況</li>
            <li>此為專業版，題目較多，請<strong>耐心作答</strong></li>
            <li>為確保結果準確，請依照<strong>真實行為</strong>作答</li>
          </ol>
          <div class="notice-meta">
            <span>題型｜單選題 × {totalQuestions}</span>
            <span>時間｜約 5–8 分鐘</span>
          </div>
        </div>

        <button type="button" class="btn btn-gold" data-action="start">靜下心來，開始測評</button>
      </section>

      <!-- ══════════ 測驗 ══════════ -->
      <section id="view-quiz" class="view" hidden>
        <div class="progress-wrap">
          <div class="progress-info">
            <span id="progress-label">第 1 頁／共 {centers.length} 頁</span>
            <span id="progress-center"></span>
          </div>
          <div class="progress-track"><div id="progress-fill" class="progress-fill"></div></div>
        </div>

        {
          centers.map((center, ci) => (
            <div class="quiz-page" data-center={ci} hidden={ci !== 0}>
              <div class="section-head">
                <p class="section-order">{center.order}</p>
                <h2 class="section-title">{center.name}</h2>
                <p class="section-sanskrit">{center.sanskrit}</p>
                <p class="section-theme">{center.theme}</p>
              </div>

              {center.questions.map((question) => {
                qNum += 1;
                const name = `q${qNum}`;
                return (
                  <fieldset class="q" data-center={ci}>
                    <legend class="q-text">
                      <span class="q-num">{qNum}</span>
                      {question.q}
                    </legend>
                    <div class="opts">
                      {question.options.map((opt) => (
                        <label class="opt">
                          <input type="radio" name={name} value={opt.s} />
                          <span class="opt-dot" aria-hidden="true" />
                          <span class="opt-text">{opt.t}</span>
                        </label>
                      ))}
                    </div>
                    <p class="q-missing-hint">請選擇一個選項</p>
                  </fieldset>
                );
              })}
            </div>
          ))
        }

        <div class="quiz-nav">
          <button type="button" class="btn btn-ghost" data-action="prev">上一頁</button>
          <button type="button" class="btn btn-gold" data-action="next">下一頁</button>
        </div>
      </section>

      <!-- ══════════ 結果 ══════════ -->
      <section id="view-result" class="view" hidden>
        <p class="kicker">YOUR ENERGY REPORT</p>
        <h1 class="hero-title hero-title--sm">你的能量報告</h1>
        <div class="gold-rule" aria-hidden="true"></div>

        <div class="card score-card">
          <p class="score-label">整體能量指數</p>
          <p class="score-value"><span id="total-score">0</span><span class="score-unit">分</span></p>
          <p id="total-comment" class="score-comment"></p>
        </div>

        <div class="card chart-card">
          <h2 class="card-title">七大能量中心</h2>
          <div id="bars"></div>
          <p class="chart-note">得分率越高，代表該能量中心越順流。</p>
        </div>

        <div class="card focus-card">
          <p class="focus-kicker">你的主要心相卡點</p>
          <h2 id="focus-name" class="focus-name"></h2>
          <p id="focus-sanskrit" class="focus-sanskrit"></p>
          <p id="focus-desc" class="focus-desc"></p>
          <div class="focus-advice">
            <p class="focus-advice-label">調頻建議</p>
            <p id="focus-advice-text"></p>
          </div>
        </div>

        <p class="disclaimer">本測評結果僅供自我覺察參考，不具醫療或心理診斷性質。</p>

        <!-- 關於 Eudora -->
        <div class="about">
          <div class="about-photo-wrap">
            <img src="/images/eudora.jpg" alt="徐羽鋅 Eudora Hsu" class="about-photo" loading="lazy" />
          </div>
          <div class="about-body">
            <p class="kicker kicker--left">ABOUT YOUR COACH</p>
            <h2 class="about-name">徐羽鋅 Eudora Hsu</h2>
            <p class="about-title">{SITE_NAME}創辦人・個人品牌形象戰略教練</p>
            <p class="about-text">
              近 10 年、上千場一對一諮詢經驗，獨創「HPIS
              全息個人品牌形象識別系統」與「身心美商能量學」，融合東方陰陽哲學、西方心理學、教練學與形象管理學——陪伴你從內在能量調頻開始，對齊外在形象與天命定位，讓內外合一，活出高能量的理想版本。
            </p>
            <div class="cta-box">
              <p class="cta-lead">想更深入了解你的能量卡點，找到專屬的調頻之路？</p>
              <a class="btn btn-gold" href={LINE_URL} target="_blank" rel="noopener">
                加入 LINE<br class="br-mobile" /> 預約 1:1 諮詢
              </a>
              <p class="cta-note">點擊後將開啟官方 LINE，由 Eudora 團隊為你安排</p>
            </div>
          </div>
        </div>

        <button type="button" class="btn btn-ghost btn-retake" data-action="retake">重新測驗</button>
      </section>
    </main>

    <footer class="site-footer">
      <p>
        © 2026 {SITE_NAME}｜<a href="https://beliefbeyou.com" target="_blank" rel="noopener">beliefbeyou.com</a>
      </p>
    </footer>

    <script type="application/json" id="quiz-data" set:html={JSON.stringify(clientData)} />

    <script>
      const data = JSON.parse(document.getElementById('quiz-data').textContent);
      const STORE_KEY = 'bbq-answers-v1';

      const views = {
        intro: document.getElementById('view-intro'),
        quiz: document.getElementById('view-quiz'),
        result: document.getElementById('view-result'),
      };
      const pages = [...document.querySelectorAll('.quiz-page')];
      const nextBtn = document.querySelector('[data-action="next"]');
      const prevBtn = document.querySelector('[data-action="prev"]');
      const progressLabel = document.getElementById('progress-label');
      const progressCenter = document.getElementById('progress-center');
      const progressFill = document.getElementById('progress-fill');

      let page = 0;

      function showView(name) {
        Object.values(views).forEach((v) => (v.hidden = true));
        views[name].hidden = false;
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      function renderPage() {
        pages.forEach((p, i) => (p.hidden = i !== page));
        const c = data.centers[page];
        progressLabel.textContent = `第 ${page + 1} 頁／共 ${pages.length} 頁`;
        progressCenter.textContent = `${c.name} ${c.sanskrit}`;
        progressFill.style.width = `${((page + 1) / pages.length) * 100}%`;
        prevBtn.style.visibility = page === 0 ? 'hidden' : 'visible';
        nextBtn.textContent = page === pages.length - 1 ? '查看我的能量報告' : '下一頁';
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      function validatePage() {
        const fields = [...pages[page].querySelectorAll('.q')];
        let firstMissing = null;
        fields.forEach((f) => {
          const ok = !!f.querySelector('input:checked');
          f.classList.toggle('q--missing', !ok);
          if (!ok && !firstMissing) firstMissing = f;
        });
        if (firstMissing) {
          firstMissing.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
        return true;
      }

      function saveAnswers() {
        const saved = {};
        document.querySelectorAll('.q input:checked').forEach((input) => {
          saved[input.name] = input.value;
        });
        try {
          sessionStorage.setItem(STORE_KEY, JSON.stringify(saved));
        } catch (e) {
          /* 私密瀏覽模式下無法儲存，略過 */
        }
      }

      function restoreAnswers() {
        try {
          const saved = JSON.parse(sessionStorage.getItem(STORE_KEY) || '{}');
          Object.entries(saved).forEach(([name, value]) => {
            const input = document.querySelector(`input[name="${name}"][value="${value}"]`);
            if (input) input.checked = true;
          });
        } catch (e) {
          /* ignore */
        }
      }

      function stateOf(pct) {
        if (pct >= data.thresholds.flow) return { label: '順流', cls: 'flow' };
        if (pct >= data.thresholds.balance) return { label: '待平衡', cls: 'balance' };
        return { label: '卡點', cls: 'block' };
      }

      function computeResult() {
        const results = data.centers.map((c, ci) => {
          let sum = 0;
          document
            .querySelectorAll(`.q[data-center="${ci}"] input:checked`)
            .forEach((input) => (sum += Number(input.value)));
          const pct = Math.round((sum / c.max) * 100);
          return { ...c, sum, pct };
        });
const totalSum = results.reduce((n, r) => n + r.sum, 0);
        const totalMax = results.reduce((n, r) => n + r.max, 0);
        const totalPct = Math.round((totalSum / totalMax) * 100);

        document.getElementById('total-score').textContent = totalSum;
        const comment =
          totalPct >= 75
            ? '整體能量流動順暢，繼續保持覺察，讓順流成為你的日常。'
            : totalPct >= 50
              ? '整體能量大致平穩，部分能量中心正等待你的調頻與關注。'
              : '有多個能量中心正在呼喚你的關注——這正是內在邀請你升級的時刻。';
        document.getElementById('total-comment').textContent = comment;

        // 長條圖
        const barsEl = document.getElementById('bars');
        barsEl.innerHTML = '';
        const weakest = results.reduce((min, r) => (r.pct < min.pct ? r : min), results[0]);
        results.forEach((r) => {
          const st = stateOf(r.pct);
          const row = document.createElement('div');
          row.className = 'bar-row' + (r === weakest ? ' bar-row--weakest' : '');
          row.innerHTML = `
            <div class="bar-head">
              <span class="bar-name">${r.name}<em>${r.sanskrit}</em></span>
              <span class="bar-tag bar-tag--${st.cls}">${st.label}</span>
            </div>
            <div class="bar-track"><div class="bar-fill bar-fill--${st.cls}" style="width:0%"></div></div>
            <span class="bar-pct">${r.pct}%</span>`;
          barsEl.appendChild(row);
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              row.querySelector('.bar-fill').style.width = `${r.pct}%`;
            })
          );
        });

        // 主要卡點
        const st = stateOf(weakest.pct);
        document.getElementById('focus-name').textContent = weakest.name;
        document.getElementById('focus-sanskrit').textContent =
          `${weakest.sanskrit}｜${weakest.theme}`;
        const desc =
          st.cls === 'flow'
            ? `你的七大能量中心整體都相當順流，「${weakest.name}」是其中相對較弱的一環。${weakest.mid}`
            : st.cls === 'balance'
              ? weakest.mid
              : weakest.low;
        document.getElementById('focus-desc').textContent = desc;
        document.getElementById('focus-advice-text').textContent = weakest.advice;
      }

      // ── 事件 ──
      document.querySelector('[data-action="start"]').addEventListener('click', () => {
        showView('quiz');
        renderPage();
      });

      nextBtn.addEventListener('click', () => {
        if (!validatePage()) return;
        if (page < pages.length - 1) {
          page += 1;
          renderPage();
        } else {
          computeResult();
          showView('result');
        }
      });

      prevBtn.addEventListener('click', () => {
        if (page > 0) {
          page -= 1;
          renderPage();
        }
      });

      document.querySelector('[data-action="retake"]').addEventListener('click', () => {
        document.querySelectorAll('.q input:checked').forEach((i) => (i.checked = false));
        document.querySelectorAll('.q--missing').forEach((f) => f.classList.remove('q--missing'));
        try {
          sessionStorage.removeItem(STORE_KEY);
        } catch (e) {
          /* ignore */
        }
        page = 0;
        showView('intro');
      });

      document.querySelectorAll('.q input').forEach((input) => {
        input.addEventListener('change', () => {
          input.closest('.q').classList.remove('q--missing');
          saveAnswers();
        });
      });

      restoreAnswers();
    </script>

    <style is:global>
      :root {
        --navy-950: #052430;
        --navy-900: #0a3a4d;
        --navy-800: #0f4d66;
        --teal: #147a99;
        --teal-soft: #1c95ba;
        --gold: #ad8550;
        --gold-light: #c9a86c;
        --gold-pale: #e5cfa4;
        --cream: #f1faff;
        --aqua: #8fdce6;
        --peach: #e7bc9d;
        --copper: #c07a52;
        --ink-soft: rgba(241, 250, 255, 0.72);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Noto Sans TC', sans-serif;
        color: var(--cream);
        background: linear-gradient(168deg, var(--navy-950) 0%, var(--navy-800) 45%, #1c7fa3 100%);
        background-attachment: fixed;
        min-height: 100vh;
        line-height: 1.7;
        letter-spacing: 0.02em;
      }

      .bg-glow {
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(ellipse 60% 40% at 85% 8%, rgba(143, 220, 230, 0.16), transparent 70%),
          radial-gradient(ellipse 55% 45% at 10% 90%, rgba(20, 122, 153, 0.35), transparent 70%),
          radial-gradient(ellipse 35% 22% at 20% 18%, rgba(241, 250, 255, 0.05), transparent 70%);
        z-index: 0;
      }

      .site-header,
      main,
      .site-footer {
        position: relative;
        z-index: 1;
      }

      /* ── Header ── */
      .site-header {
        display: flex;
        justify-content: center;
        padding: 28px 20px 0;
      }

      .brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }

      .brand-logo {
        height: 52px;
        width: auto;
        display: block;
      }

      .brand-en {
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--aqua);
        text-align: center;
      }

      /* ── Layout ── */
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      .view[hidden] {
        display: none !important;
      }

      .kicker {
        text-align: center;
        font-size: 0.7rem;
        letter-spacing: 0.45em;
        color: var(--gold-light);
        margin-bottom: 18px;
      }

      .kicker--left {
        text-align: left;
        margin-bottom: 10px;
      }

      .hero-title {
        font-family: 'Noto Serif TC', serif;
        font-size: clamp(2.1rem, 6vw, 3rem);
        font-weight: 600;
        text-align: center;
        letter-spacing: 0.18em;
      }

      .hero-title--sm {
        font-size: clamp(1.8rem, 5vw, 2.4rem);
      }

      .hero-sub {
        text-align: center;
        color: var(--aqua);
        letter-spacing: 0.22em;
        margin-top: 10px;
        font-size: 0.95rem;
      }

      .gold-rule {
        width: 64px;
        height: 1px;
        margin: 26px auto;
        background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
        position: relative;
      }

      .gold-rule::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        width: 5px;
        height: 5px;
        transform: translate(-50%, -50%) rotate(45deg);
        background: var(--gold-light);
      }

      .hero-lead {
        text-align: center;
        color: var(--ink-soft);
        font-size: 0.98rem;
        margin-bottom: 36px;
      }

      /* ── Cards ── */
      .card {
        background: rgba(241, 250, 255, 0.045);
        border: 1px solid rgba(201, 168, 108, 0.22);
        border-radius: 14px;
        padding: 30px 28px;
        margin-bottom: 28px;
        backdrop-filter: blur(6px);
      }

      .card-title {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.3em;
        color: var(--gold-pale);
        text-align: center;
        margin-bottom: 20px;
      }

      .notice-list {
        list-style: none;
        counter-reset: notice;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 22px;
      }

      .notice-list li {
        counter-increment: notice;
        position: relative;
        padding-left: 2em;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .notice-list li::before {
        content: counter(notice, cjk-ideographic);
        position: absolute;
        left: 0;
        top: 0.1em;
        font-family: 'Noto Serif TC', serif;
        color: var(--gold-light);
        font-size: 0.85rem;
      }

      .notice-list strong {
        color: var(--cream);
      }
.notice-meta {
        display: flex;
        justify-content: center;
        gap: 24px;
        padding-top: 16px;
        border-top: 1px solid rgba(201, 168, 108, 0.18);
        font-size: 0.82rem;
        color: var(--aqua);
        letter-spacing: 0.1em;
        flex-wrap: wrap;
      }

      /* ── Buttons ── */
      .btn {
        display: inline-block;
        border: none;
        cursor: pointer;
        font-family: 'Noto Sans TC', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        padding: 15px 42px;
        border-radius: 999px;
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          background 0.25s ease;
        text-decoration: none;
        text-align: center;
      }

      .btn-gold {
        background: linear-gradient(135deg, var(--gold-light), var(--gold));
        color: var(--navy-950);
        box-shadow: 0 6px 24px rgba(173, 133, 80, 0.35);
      }

      .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(173, 133, 80, 0.5);
      }

      .btn-ghost {
        background: transparent;
        color: var(--aqua);
        border: 1px solid rgba(168, 202, 206, 0.4);
      }

      .btn-ghost:hover {
        border-color: var(--aqua);
        color: var(--cream);
      }

      #view-intro {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      #view-intro .notice-card {
        width: 100%;
        max-width: 520px;
      }

      /* ── Quiz ── */
      .progress-wrap {
        position: sticky;
        top: 0;
        z-index: 5;
        background: linear-gradient(180deg, rgba(12, 26, 44, 0.96), rgba(12, 26, 44, 0.88));
        backdrop-filter: blur(8px);
        padding: 16px 4px 14px;
        margin: -10px -4px 26px;
        border-bottom: 1px solid rgba(201, 168, 108, 0.18);
      }

      .progress-info {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.8rem;
        color: var(--aqua);
        letter-spacing: 0.08em;
        margin-bottom: 8px;
      }

      #progress-center {
        color: var(--gold-pale);
      }

      .progress-track {
        height: 3px;
        border-radius: 2px;
        background: rgba(241, 250, 255, 0.12);
        overflow: hidden;
      }

      .progress-fill {
        height: 100%;
        width: 0%;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--teal-soft), var(--gold-light));
        transition: width 0.4s ease;
      }

      .section-head {
        text-align: center;
        margin-bottom: 34px;
      }

      .section-order {
        font-family: 'Noto Serif TC', serif;
        color: var(--gold-light);
        font-size: 0.95rem;
        letter-spacing: 0.4em;
        margin-bottom: 6px;
      }

      .section-title {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.65rem;
        font-weight: 600;
        letter-spacing: 0.24em;
      }

      .section-sanskrit {
        color: var(--aqua);
        font-size: 0.8rem;
        letter-spacing: 0.3em;
        margin-top: 6px;
        text-transform: uppercase;
      }

      .section-theme {
        color: var(--ink-soft);
        font-size: 0.88rem;
        margin-top: 10px;
        letter-spacing: 0.12em;
      }

      .q {
        border: 1px solid rgba(201, 168, 108, 0.18);
        border-radius: 14px;
        background: rgba(241, 250, 255, 0.04);
        padding: 24px 22px;
        margin-bottom: 20px;
        transition: border-color 0.3s ease;
      }

      .q--missing {
        border-color: rgba(231, 140, 110, 0.75);
      }

      .q-missing-hint {
        display: none;
        color: #e7a184;
        font-size: 0.8rem;
        margin-top: 10px;
        letter-spacing: 0.08em;
      }

      .q--missing .q-missing-hint {
        display: block;
      }

      .q-text {
        float: left;
        width: 100%;
        font-family: 'Noto Serif TC', serif;
        font-size: 1.05rem;
        font-weight: 500;
        line-height: 1.6;
        margin-bottom: 16px;
        color: var(--cream);
      }

      .opts {
        clear: both;
      }

      .q-num {
        display: inline-block;
        color: var(--gold-light);
        font-size: 0.9rem;
        margin-right: 8px;
      }

      .q-num::after {
        content: '.';
      }

      .opts {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .opt {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border: 1px solid rgba(168, 202, 206, 0.22);
        border-radius: 10px;
        cursor: pointer;
        transition:
          border-color 0.2s ease,
          background 0.2s ease;
        font-size: 0.93rem;
        color: var(--ink-soft);
      }

      .opt:hover {
        border-color: rgba(201, 168, 108, 0.5);
        background: rgba(201, 168, 108, 0.06);
      }

      .opt input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .opt-dot {
        flex: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 1.5px solid rgba(168, 202, 206, 0.55);
        position: relative;
        transition: border-color 0.2s ease;
      }

      .opt:has(input:checked) {
        border-color: var(--gold-light);
        background: rgba(201, 168, 108, 0.12);
        color: var(--cream);
      }

      .opt:has(input:checked) .opt-dot {
        border-color: var(--gold-light);
      }

      .opt:has(input:checked) .opt-dot::after {
        content: '';
        position: absolute;
        inset: 3px;
        border-radius: 50%;
        background: var(--gold-light);
      }

      .opt:has(input:focus-visible) {
        outline: 2px solid var(--aqua);
        outline-offset: 2px;
      }

      .quiz-nav {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 34px;
      }

      /* ── Result ── */
      .score-card {
        text-align: center;
      }

      .score-label {
        font-size: 0.8rem;
        letter-spacing: 0.35em;
        color: var(--aqua);
        margin-bottom: 10px;
      }

      .score-value {
        font-family: 'Noto Serif TC', serif;
        font-size: 3.4rem;
        font-weight: 600;
        color: var(--gold-pale);
        line-height: 1.1;
      }

      .score-unit {
        font-size: 1.1rem;
        margin-left: 6px;
        color: var(--gold-light);
      }

      .score-comment {
        margin-top: 14px;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .bar-row {
        padding: 14px 6px;
        border-bottom: 1px solid rgba(241, 250, 255, 0.07);
        display: grid;
grid-template-columns: 1fr auto;
        grid-template-areas:
          'head head'
          'track pct';
        gap: 8px 14px;
        align-items: center;
      }

      .bar-row:last-child {
        border-bottom: none;
      }

      .bar-row--weakest {
        background: rgba(192, 122, 82, 0.08);
        border-radius: 10px;
        border-bottom-color: transparent;
        padding-inline: 14px;
      }

      .bar-head {
        grid-area: head;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
      }

      .bar-name {
        font-family: 'Noto Serif TC', serif;
        font-size: 0.98rem;
        letter-spacing: 0.1em;
      }

      .bar-name em {
        font-style: normal;
        font-size: 0.7rem;
        color: var(--aqua);
        margin-left: 8px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .bar-tag {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        padding: 3px 10px;
        border-radius: 999px;
        flex: none;
      }

      .bar-tag--flow {
        color: var(--aqua);
        border: 1px solid rgba(168, 202, 206, 0.5);
      }

      .bar-tag--balance {
        color: var(--gold-pale);
        border: 1px solid rgba(201, 168, 108, 0.5);
      }

      .bar-tag--block {
        color: var(--peach);
        border: 1px solid rgba(192, 122, 82, 0.65);
      }

      .bar-track {
        grid-area: track;
        height: 8px;
        border-radius: 4px;
        background: rgba(241, 250, 255, 0.1);
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .bar-fill--flow {
        background: linear-gradient(90deg, var(--teal-soft), var(--aqua));
      }

      .bar-fill--balance {
        background: linear-gradient(90deg, var(--gold), var(--gold-pale));
      }

      .bar-fill--block {
        background: linear-gradient(90deg, var(--copper), var(--peach));
      }

      .bar-pct {
        grid-area: pct;
        font-size: 0.85rem;
        color: var(--ink-soft);
        min-width: 3.2em;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      .chart-note {
        margin-top: 16px;
        font-size: 0.78rem;
        color: rgba(168, 202, 206, 0.7);
        text-align: center;
        letter-spacing: 0.08em;
      }

      .focus-card {
        border-color: rgba(192, 122, 82, 0.45);
        background:
          radial-gradient(ellipse 90% 120% at 50% -20%, rgba(192, 122, 82, 0.12), transparent 60%),
          rgba(241, 250, 255, 0.045);
        text-align: center;
      }

      .focus-kicker {
        font-size: 0.75rem;
        letter-spacing: 0.4em;
        color: var(--peach);
        margin-bottom: 12px;
      }

      .focus-name {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.8rem;
        font-weight: 600;
        letter-spacing: 0.2em;
      }

      .focus-sanskrit {
        color: var(--aqua);
        font-size: 0.82rem;
        letter-spacing: 0.18em;
        margin: 8px 0 18px;
      }

      .focus-desc {
        color: var(--ink-soft);
        font-size: 0.95rem;
        text-align: left;
      }

      .focus-advice {
        margin-top: 20px;
        padding: 18px 20px;
        border-radius: 10px;
        background: rgba(201, 168, 108, 0.09);
        border: 1px solid rgba(201, 168, 108, 0.3);
        text-align: left;
      }

      .focus-advice-label {
        font-family: 'Noto Serif TC', serif;
        color: var(--gold-pale);
        font-size: 0.85rem;
        letter-spacing: 0.3em;
        margin-bottom: 8px;
      }

      .focus-advice p:last-child,
      .focus-advice #focus-advice-text {
        color: var(--ink-soft);
        font-size: 0.93rem;
      }

      .disclaimer {
        text-align: center;
        font-size: 0.75rem;
        color: rgba(168, 202, 206, 0.55);
        letter-spacing: 0.08em;
        margin: 6px 0 46px;
      }

      /* ── About ── */
      .about {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 30px;
        align-items: start;
        padding: 34px 30px;
        border-radius: 14px;
        border: 1px solid rgba(201, 168, 108, 0.28);
        background:
          radial-gradient(ellipse 100% 130% at 100% 0%, rgba(31, 112, 142, 0.18), transparent 60%),
          rgba(241, 250, 255, 0.05);
        margin-bottom: 34px;
      }

      .about-photo-wrap {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(201, 168, 108, 0.35);
        box-shadow: 0 12px 32px rgba(12, 26, 44, 0.5);
      }

      .about-photo {
        display: block;
        width: 100%;
        height: auto;
      }

      .about-name {
        font-family: 'Noto Serif TC', serif;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: 0.08em;
      }

      .about-title {
        color: var(--gold-pale);
        font-size: 0.85rem;
        letter-spacing: 0.12em;
        margin: 6px 0 14px;
      }

      .about-text {
        color: var(--ink-soft);
        font-size: 0.92rem;
      }

      .cta-box {
        margin-top: 22px;
        text-align: center;
        padding: 22px 18px;
        border-radius: 12px;
        background: rgba(12, 26, 44, 0.45);
        border: 1px solid rgba(201, 168, 108, 0.25);
      }

      .cta-lead {
        font-family: 'Noto Serif TC', serif;
        font-size: 1rem;
        margin-bottom: 16px;
        color: var(--cream);
        letter-spacing: 0.06em;
      }

      .cta-note {
        margin-top: 12px;
        font-size: 0.75rem;
        color: rgba(168, 202, 206, 0.65);
        letter-spacing: 0.08em;
      }

      .btn-retake {
        display: block;
        margin: 0 auto;
      }

      /* ── Footer ── */
      .site-footer {
        text-align: center;
        padding: 30px 20px 44px;
        font-size: 0.78rem;
        color: rgba(168, 202, 206, 0.6);
        letter-spacing: 0.1em;
      }

      .site-footer a {
        color: var(--gold-light);
        text-decoration: none;
      }

      .site-footer a:hover {
        text-decoration: underline;
      }

      .br-mobile {
        display: none;
      }

      /* ── RWD ── */
      @media (max-width: 640px) {
        .br-mobile {
          display: inline;
        }

        main {
          padding: 30px 16px 60px;
        }

        .card {
          padding: 24px 18px;
        }

        .about {
          grid-template-columns: 1fr;
          padding: 26px 20px;
        }

        .about-photo-wrap {
          max-width: 220px;
          margin: 0 auto;
        }

        .about-body {
          text-align: center;
        }

        .kicker--left {
          text-align: center;
        }

        .about-text {
          text-align: left;
        }

        .quiz-nav .btn {
          padding-inline: 28px;
          flex: 1;
        }
       </style>
  </body>
</html>
